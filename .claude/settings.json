{
  "description": "Recordatorio de mantener docs/ESTADO-DEL-PROYECTO.md al dia cuando cambia el codigo o el esquema.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/recordar-estado-del-proyecto.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Revisando el estado del proyecto"
          }
        ]
      }
    ]
  }
}
