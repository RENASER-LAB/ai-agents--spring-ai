# Copia este archivo como application-secrets.yaml (sin .example) y rellena los valores.
# El archivo real esta en .gitignore: nunca se sube al repositorio.

supabase:
  # Solo para los agentes de IA, que leen datos de un Supabase por su API REST.
  # Dashboard -> Project Settings -> API Keys -> Legacy API Keys -> service_role
  service-role-key: PEGA_AQUI_TU_SERVICE_ROLE_KEY

renaser:
  supabase:
    db:
      # Solo hacen falta si arrancas con el perfil "supabase", es decir, si quieres que la
      # base de datos principal sea la de Supabase en vez del contenedor local.
      # Dashboard -> boton "Connect" -> pestana "Session pooler" (NO "Transaction pooler").
      #
      # Ejemplo de host: aws-1-us-east-2.pooler.supabase.com
      host: PEGA_AQUI_EL_HOST_DEL_POOLER
      # El usuario del pooler lleva pegada la referencia del proyecto: postgres.<referencia>
      user: postgres.PEGA_AQUI_LA_REFERENCIA_DEL_PROYECTO
      # La contrasena de la base, la que elegiste al crear el proyecto.
      # Si no la recuerdas: Dashboard -> Project Settings -> Database -> Reset password
      password: PEGA_AQUI_LA_CONTRASENA_DE_LA_BASE

google:
  gemini:
    # Los embeddings del buscador van a Google. Sin esta clave la aplicacion NO arranca:
    # application.yaml la exige y no tiene valor por defecto.
    # https://aistudio.google.com/apikey
    api-key: PEGA_AQUI_TU_API_KEY_DE_GEMINI

spring:
  ai:
    deepseek:
      # El modelo que califica los curriculums. Sin esta clave la aplicacion arranca, pero
      # la primera calificacion falla con un 401 del proveedor.
      api-key: PEGA_AQUI_TU_API_KEY_DE_DEEPSEEK

app:
  seguridad:
    # Clave HMAC para firmar los tokens del portal y del panel.
    # Genera una con:  openssl rand -base64 48
    #
    # Este texto de ejemplo mide menos de 32 bytes a proposito: asi la aplicacion se niega
    # a arrancar mientras siga puesto. Una clave de ejemplo que arranca es peor que ninguna,
    # porque esta escrita en el repositorio y cualquiera que lo lea puede firmar tokens.
    jwt-secreto: PEGA_AQUI_LA_CLAVE
