# Copiar a .env y rellenar. .env NO se versiona: lleva las mismas claves que
# application-secrets.yaml, que tampoco esta en git.
#
#   cp .env.example .env && nano .env
#
# De donde sale cada valor: casi todos estan ya en tu application-secrets.yaml local.
# Se copian tal cual; no hace falta inventar ninguno salvo los dos que se indican.

# La imagen en ECR. <CUENTA> es tu id de 12 digitos.
IMAGEN=526338061654.dkr.ecr.us-east-1.amazonaws.com/ai-engine:latest

# ---- Base de datos (Supabase) ----
# OJO: la cadena DIRECTA, puerto 5432. NO la del pooler de transacciones (6543),
# que rompe las migraciones de Flyway al arrancar.
# En tu yml: spring.datasource.url / username / password
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ---- La cola ----
# RabbitMQ corre como un contenedor mas de este compose; el HOST es «rabbitmq», el nombre
# del servicio, y lo resuelve la red interna. No apuntar aqui un endpoint externo.
# El usuario y la contrasena los eliges tu: el broker crea ese usuario la primera vez que
# arranca con el volumen vacio (y las mismas variables las lee la aplicacion, asi que no
# hay dos sitios que mantener). Para la contrasena: openssl rand -base64 32
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ---- IA ----
# En tu yml: spring.ai.deepseek.api-key  y  google.gemini.api-key
DEEPSEEK_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ---- Seguridad y almacen ----
# JWT_SECRETO: minimo 32 caracteres, y DISTINTO del local. Si se reutiliza, un token
# emitido en la maquina de un desarrollador vale en produccion.
#   openssl rand -base64 48
# En tu yml: app.seguridad.jwt-secreto  y  supabase.service-role-key
JWT_SECRETO=
SUPABASE_SERVICE_ROLE_KEY=

# La clave del bucket de curriculums. En tu yml: app.archivos.supabase.clave
APP_ARCHIVOS_SUPABASE_CLAVE=

# ---- Correo ----
# Dejar CORREO_TRANSPORTE=log para arrancar sin mandar nada. Con «smtp» manda de verdad.
# La contrasena de Gmail es la «de aplicacion» de 16 letras, sin espacios.
CORREO_TRANSPORTE=log
CORREO_REMITENTE=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- El portal ----
PORTAL_URL=https://renaser-os-postulantes.vercel.app

# ---- La maquina ----
# Con 4 GB (t4g.medium) pon 3g. Con 2 GB (t4g.small) deja 1500m: la cola y el sistema
# tambien necesitan su parte.
MEMORIA_APP=3g

# El dominio que apunta a esta maquina. Vacio = HTTP por IP, sin certificado.
DOMINIO=
