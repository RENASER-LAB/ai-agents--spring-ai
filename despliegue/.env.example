# Copiar a .env y rellenar. .env NO se versiona: lleva las mismas claves que
# application-secrets.yaml, que tampoco esta en git.
#
#   cp .env.example .env && nano .env
#
# De donde sale cada valor: casi todos estan ya en tu application-secrets.yaml local.
# Se copian tal cual; no hace falta inventar ninguno salvo los dos que se indican.

# La imagen en ECR. <CUENTA> es tu id de 12 digitos.
IMAGEN=526338061654.dkr.ecr.us-east-1.amazonaws.com/ai-engine:latest

# ---- Base de datos (Supabase) ----
# OJO: la cadena DIRECTA, puerto 5432. NO la del pooler de transacciones (6543),
# que rompe las migraciones de Flyway al arrancar.
# En tu yml: spring.datasource.url / username / password
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ---- La cola: Amazon MQ ----
# El broker es «renaser-mq» (RabbitMQ 4.2, us-east-1). El HOST va SIN «amqps://» y SIN
# puerto: Spring arma la url el solo, y pegar el endpoint entero da un fallo de resolucion
# de nombre que no menciona el esquema.
# El usuario y la contrasena son los que se pusieron al crear el broker; no se pueden
# recuperar desde la API de AWS, se gestionan dentro del propio RabbitMQ.
RABBITMQ_HOST=b-f83a4881-fd75-4908-a634-5f5fabd46090.mq.us-east-1.on.aws
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ---- IA ----
# En tu yml: spring.ai.deepseek.api-key  y  google.gemini.api-key
DEEPSEEK_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ---- Seguridad y almacen ----
# JWT_SECRETO: minimo 32 caracteres, y DISTINTO del local. Si se reutiliza, un token
# emitido en la maquina de un desarrollador vale en produccion.
#   openssl rand -base64 48
# En tu yml: app.seguridad.jwt-secreto  y  supabase.service-role-key
JWT_SECRETO=
SUPABASE_SERVICE_ROLE_KEY=

# La clave del bucket de curriculums. En tu yml: app.archivos.supabase.clave
APP_ARCHIVOS_SUPABASE_CLAVE=

# ---- Correo ----
# Dejar CORREO_TRANSPORTE=log para arrancar sin mandar nada. Con «smtp» manda de verdad.
# La contrasena de Gmail es la «de aplicacion» de 16 letras, sin espacios.
CORREO_TRANSPORTE=log
CORREO_REMITENTE=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- El portal ----
PORTAL_URL=https://renaser-os-postulantes.vercel.app

# ---- La maquina ----
# Con 4 GB (t4g.medium) pon 3g. Con 2 GB (t4g.small) deja 1500m: la cola y el sistema
# tambien necesitan su parte.
MEMORIA_APP=3g

# El dominio que apunta a esta maquina. Vacio = HTTP por IP, sin certificado.
DOMINIO=

# =============================================================================
# ---- El modulo de Talento (renaser-os-talent-backend) ----
# =============================================================================
# Se sumo el 24/08/2026. Hasta entonces estaba escrito y probado pero no corria en
# ningun entorno, y la mitad del checklist del Sprint 1 no se podia verificar
# «llamando directo a la API», que es como el documento exige comprobarlo.

# La imagen en ECR. Repositorio distinto al del motor; hay que crearlo una vez:
#   aws ecr create-repository --repository-name renaser-os-talent --region us-east-1
IMAGEN_TALENTO=<CUENTA>.dkr.ecr.us-east-1.amazonaws.com/renaser-os-talent:latest

# La MISMA base que el motor: se reusan SPRING_DATASOURCE_* de arriba, el compose se
# encarga de pasarlas con los nombres que este modulo espera. Aqui solo su cupo de
# conexiones: cinco de las treinta del proyecto (el motor ya reserva doce).
RENASER_DB_POOL_MAX=5

# ⚠️ La identidad la emite Supabase Auth, no este backend. SIN EL JWKS EL MODULO
# ARRANCA DENEGANDO TODO: falla cerrado, no abierto, asi que el servicio levanta y
# responde 401 a todo, que parece roto y no lo esta.
#   https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
TALENTO_JWKS_URI=
#   https://<ref>.supabase.co/auth/v1
TALENTO_JWT_ISSUER=
TALENTO_JWT_AUDIENCE=authenticated

# Los origenes del panel que pueden llamarle. NUNCA «*».
#   ejemplo: https://panel.renaser.pe,http://localhost:5173
TALENTO_ORIGENES=

# Techo de memoria. La maquina es una t3.medium (4 GB): el motor toma 2g, este 1g,
# Caddy unos 50 MB y el resto es del sistema. Sale justo, y por eso va escrito.
MEMORIA_TALENTO=1g

# El interruptor que enciende el modulo de Talento. Sin esta linea, `docker compose up`
# levanta solo el motor y Caddy, exactamente como antes del 24/08/2026. Con ella, tambien
# talento — y entonces IMAGEN_TALENTO y las TALENTO_* de arriba son obligatorias.
#   COMPOSE_PROFILES=talento
COMPOSE_PROFILES=
